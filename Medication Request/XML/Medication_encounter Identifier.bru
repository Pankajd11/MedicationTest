meta {
  name: Medication_encounter Identifier
  type: http
  seq: 8
}

get {
  url: {{im1asurl}}api/v2/fhir/MedicationRequest?encounter.identifier=http://mein-krankenhaus.example/fhir/sid/fallnummern|4417532&enablelogging=True
  body: none
  auth: bearer
}

params:query {
  encounter.identifier: http://mein-krankenhaus.example/fhir/sid/fallnummern|4417532
  enablelogging: True
}

headers {
  Upgrade: TLS 1.2
  Content-Type: application/fhir+xml
  Accept: application/fhir+xml
}

auth:bearer {
  token: {{token}}
}

tests {
  test("Content verification", function () {
      expect(JSON.stringify(res.getBody())).to.include("f0024");
  });
}
