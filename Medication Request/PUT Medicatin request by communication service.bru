tests {
  test("To check API Status",function(){
      expect(res.getStatus()).to.equal(201)
  });
  
  var tv4 = require('tv4');
  var responseBody = JSON.stringify(res.getBody());
  
  
  // Extract the JSON Schema from the environment or collection
  var jsonSchema = bru.getVar("schemaMddication");
  console.log(jsonSchema)
  var result = tv4.validate(responseBody, jsonSchema);
  
  
  // Check if validation passed
  test("Verifying Schema validation", function () {
      expect(result).to.be.true;
  });
}
