meta {
  name: SaveMedication JSON Max data
  type: http
  seq: 3
}

put {
  url: {{im1asurl}}api/v2/fhir/Medication/443
  body: json
  auth: none
}

headers {
  Upgrade: TLS 1.2
  Content-Type: application/fhir+json; charset=utf-8
  content: application/fhir+json
  Authorization: Bearer {{token}}
}

