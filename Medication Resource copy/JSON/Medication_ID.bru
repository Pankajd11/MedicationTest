}

get {
  url: {{im1asurl}}api/v2/fhir/Medication?_id=305
  body: none
  auth: bearer
}

params:query {
  _id: 305
}

headers {
  Upgrade: TLS 1.2
  Content-Type: application/fhir+json
  Accept: application/fhir+json
}

auth:bearer {
  token: {{token}}
}

